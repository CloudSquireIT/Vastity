{
  "name": "vastity",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Vastity \u2014 esplora il cielo e lo spazio in full immersion",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "test:devices": "node tests/device-check.mjs",
    "cap:sync": "VASTITY_NATIVE=1 npm run build && npx cap sync",
    "cap:assets": "capacitor-assets generate --iconBackgroundColor '#03050c' --iconBackgroundColorDark '#03050c' --splashBackgroundColor '#03050c' --splashBackgroundColorDark '#03050c' --android --ios",
    "test:accuracy": "node tests/accuracy.cjs"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.10",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/motion": "^7.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "satellite.js": "^7.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "@types/three": "^0.187.0",
    "typescript": "5.9",
    "vite": "^8.3.8"
  }
}
